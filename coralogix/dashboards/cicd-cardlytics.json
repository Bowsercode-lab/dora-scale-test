            "widgets": [
              {
                "id": {
                  "value": "55887ca2-fef2-41e0-84ce-8004a682b53d"
                },
                "title": "Pipeline health by workflow file",
                "description": "One row per workflow file. Run names can change on every run, so the file path is the stable name of a pipeline.",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.applicationname == 'github' && $d.github_event == 'workflow_run' && $d['github-app-v2'].action == 'completed' | create duration_seconds from ($d['github-app-v2'].workflow_run.updated_at:timestamp - $d['github-app-v2'].workflow_run.run_started_at:timestamp):num / 1000000000 | groupby $d['github-app-v2'].repository.full_name as repository, $d['github-app-v2'].workflow_run.path as workflow_file aggregate count() as runs, sum(if($d['github-app-v2'].workflow_run.conclusion == 'failure', 1, 0)) as failures, sum(if($d['github-app-v2'].workflow_run.run_attempt:num > 1, 1, 0)) as reruns, percentile(0.5, duration_seconds) as median_seconds, percentile(0.95, duration_seconds) as p95_seconds | create failure_pct from if(runs > 0, failures / runs * 100, 0) | orderby failure_pct desc | choose workflow_file, repository, runs, failures, failure_pct, reruns, median_seconds, p95_seconds"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "workflow_file"
                      },
                      {
                        "field": "repository"
                      },
                      {
                        "field": "runs"
                      },
                      {
                        "field": "failures"
                      },
                      {
                        "field": "failure_pct"
                      },
                      {
                        "field": "reruns"
                      },
                      {
                        "field": "median_seconds"
                      },
                      {
                        "field": "p95_seconds"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE"
                  }
                },
                "highlighted": false
              }
            ]
          },
