                  "value": "7a32d30c-e380-4959-b32c-d112c894cb15"
                },
                "title": "Runs that were re-runs",
                "description": "Percent of completed workflow runs with run_attempt above 1 (developers had to retry).",
                "definition": {
                  "gauge": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.applicationname == 'github' && $d.github_event == 'workflow_run' && $d['github-app-v2'].action == 'completed' | aggregate count() as completions, sum(if($d['github-app-v2'].workflow_run.run_attempt:num > 1, 1, 0)) as reruns | create rerun_pct from if(completions > 0, reruns / completions * 100, 0) | choose rerun_pct"
                        },
                        "filters": []
                      }
                    },
                    "min": 0,
                    "max": 100,
                    "showInnerArc": true,
                    "showOuterArc": true,
                    "unit": "UNIT_PERCENT",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "var(--c-visualization-green-05)"
                      },
                      {
                        "from": 10,
                        "color": "var(--c-visualization-yellow-05)"
                      },
                      {
                        "from": 30,
                        "color": "var(--c-visualization-red-05)"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE",
                    "thresholdBy": "THRESHOLD_BY_UNSPECIFIED",
                    "decimal": 1,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "legend": {
