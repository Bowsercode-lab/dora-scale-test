              {
                "id": {
                  "value": "0b993d90-14f5-4e41-b166-7c5480196155"
                },
                "title": "CI runs by team",
                "description": "Team from the cdlx_ownership table: the folder in \"Deploy <folder> ...\", the service in \"Release <service>\" or \"<service>@v<version>\" run titles, else the repository.",
                "definition": {
                  "dataTable": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.applicationname == 'github' && $d.github_event == 'workflow_run' && $d['github-app-v2'].action == 'completed' | create duration_seconds from ($d['github-app-v2'].workflow_run.updated_at:timestamp - $d['github-app-v2'].workflow_run.run_started_at:timestamp):num / 1000000000 | create run_title from $d['github-app-v2'].workflow_run.display_title | extract run_title into parsed using regexp(e=/^(?:Deploy (?<folder>\\S+)|Release (?<service>\\S+)|(?<helm>[A-Za-z0-9_.-]+)@v\\d)/) | create owner_key from firstNonNull(parsed.folder, parsed.service, parsed.helm, $d['github-app-v2'].repository.name) | enrich owner_key into owner using cdlx_ownership | groupby owner.team as team, $d['github-app-v2'].workflow_run.path as workflow_file aggregate count() as runs, sum(if($d['github-app-v2'].workflow_run.conclusion == 'failure', 1, 0)) as failures, sum(if($d['github-app-v2'].workflow_run.run_attempt:num > 1, 1, 0)) as reruns, percentile(0.5, duration_seconds) as median_seconds, percentile(0.95, duration_seconds) as p95_seconds | create failure_pct from if(runs > 0, failures / runs * 100, 0) | orderby runs desc | choose team, workflow_file, runs, failures, failure_pct, median_seconds"
                        },
                        "filters": []
                      }
                    },
                    "resultsPerPage": 20,
                    "rowStyle": "ROW_STYLE_ONE_LINE",
                    "columns": [
                      {
                        "field": "team"
                      },
                      {
                        "field": "workflow_file"
                      },
                      {
                        "field": "runs"
                      },
                      {
                        "field": "failures"
                      },
                      {
                        "field": "failure_pct"
                      },
                      {
                        "field": "median_seconds"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE"
                  }
                },
                "highlighted": false
              }
            ]
