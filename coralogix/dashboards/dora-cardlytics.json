            "widgets": [
              {
                "id": {
                  "value": "43d16635-5852-44db-bc7f-b59846452c44"
                },
                "title": "Deployment frequency (per week)",
                "description": "Average successful prod deployments per calendar week. Failed deploy runs excluded.",
                "definition": {
                  "gauge": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.applicationname == 'cicd' && $l.subsystemname == 'deployments' && $d.dora.event_type == 'deployment' && $d.dora.env == 'prod' | filter $d.dora.outcome == 'success' | groupby $m.timestamp.roundTime(7d) as week aggregate count() as deploys | aggregate avg(deploys) as deploys_per_week"
                        },
                        "filters": []
                      }
                    },
                    "min": 0,
                    "max": 50,
                    "showInnerArc": true,
                    "showOuterArc": true,
                    "unit": "UNIT_NUMBER",
                    "thresholds": [
                      {
                        "from": 0,
                        "color": "var(--c-visualization-blue-05)"
                      }
                    ],
                    "dataModeType": "DATA_MODE_TYPE_ARCHIVE",
                    "thresholdBy": "THRESHOLD_BY_UNSPECIFIED",
                    "decimal": 1,
                    "thresholdType": "THRESHOLD_TYPE_ABSOLUTE",
                    "legend": {
                      "isVisible": true,
                      "columns": [],
                      "groupByQuery": true,
                      "placement": "LEGEND_PLACEMENT_AUTO"
                    },
                    "legendBy": "LEGEND_BY_GROUPS",
                    "displaySeriesName": false,
                    "decimalPrecision": false
                  }
                },
                "highlighted": false
              },
              {
                "id": {
