              {
                "id": {
                  "value": "d7d88fbf-7558-41d6-87df-00df44840a09"
                },
                "title": "Change failure rate",
                "description": "Percent of successful prod deploys that remediated an earlier deploy (rollback, revert or hotfix).",
                "definition": {
                  "gauge": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.applicationname == 'cicd' && $l.subsystemname == 'deployments' && $d.dora.event_type == 'deployment' && $d.dora.env == 'prod' | filter $d.dora.outcome == 'success' | aggregate count() as deploys, sum(if($d.dora.remediation == true, 1, 0)) as remediations | create change_failure_rate_pct from if(deploys > 0, remediations / deploys * 100, 0) | choose change_failure_rate_pct"
                        },
                        "filters": []
                      }
                    },
                    "min": 0,
                    "max": 100,
                    "showInnerArc": true,
                    "showOuterArc": true,
