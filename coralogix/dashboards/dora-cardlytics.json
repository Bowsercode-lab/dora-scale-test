                "definition": {
                  "gauge": {
                    "query": {
                      "dataprime": {
                        "dataprimeQuery": {
                          "text": "source logs | filter $l.applicationname == 'cicd' && $l.subsystemname == 'deployments' && $d.dora.event_type == 'change' && $d.dora.env == 'prod' | aggregate percentile(0.5, $d.dora.lead_time_seconds:num) as median_lead_time_seconds"
                        },
                        "filters": []
                      }
                    },
                    "min": 0,
