{
  "name": "DORA: Cardlytics (lab)",
  "description": "DORA metrics from the report-deploy pipeline step (application cicd, subsystem deployments). Recreates the Datadog DORA Metrics and IDP DORA report screens. Filter by team, service or project_path.",
  "layout": {
    "sections": [
      {
        "id": {
