                          "text": "source logs | filter $l.applicationname == 'cicd' && $l.subsystemname == 'deployments' && $d.dora.event_type == 'deployment' && $d.dora.env == 'prod' | groupby $d.dora.service as service, $d.dora.team as team aggregate sum(if($d.dora.outcome == 'success', 1, 0)) as deploys, sum(if($d.dora.outcome == 'failure', 1, 0)) as failed_runs, sum(if($d.dora.remediation == true, 1, 0)) as remediations, max($m.timestamp) as last | create change_failure_rate_pct from if(deploys > 0, remediations / deploys * 100, 0) | create last_deploy from formatTimestamp(last:timestamp, '%Y-%m-%d %H:%M') | orderby deploys desc | choose service, team, deploys, failed_runs, remediations, change_failure_rate_pct, last_deploy"
